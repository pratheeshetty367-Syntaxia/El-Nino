{
  "paper": {
    "title": "Lead-Time Oceanic Predictor Importance Analysis for Extreme El Niño Using XGBoost and SHAP",
    "authors": [
      "Pratheeksha Shetty",
      "Rakshitha P"
    ],
    "institution": "Department of MCA, NMAM Institute of Technology (NMAMIT), Nitte (Deemed to be University)"
  },
  "dataset": {
    "records": 544,
    "period": "January 1980 – April 2025",
    "seasons": 45,
    "class_distribution": {
      "Non-Niño": 30,
      "Normal El Niño": 12,
      "Extreme El Niño": 3
    },
    "extreme_events": [
      "1982/83",
      "1997/98",
      "2015/16"
    ],
    "thresholds": {
      "extreme": ">= 2.0 °C",
      "normal": ">= 0.5 °C and < 2.0 °C",
      "non_nino": "< 0.5 °C"
    }
  },
  "predictors": [
    {
      "name": "Sea Surface Temperature (SST)",
      "key": "sst_anom",
      "source": "NOAA ERSSTv6 (gridded, 2°×2°)",
      "region": "Global, focus on equatorial Pacific",
      "role": "Surface warming"
    },
    {
      "name": "Ocean Heat Content (OHC)",
      "key": "ohc_anom",
      "source": "NOAA GODAS, subsurface potential temperature to 300 m",
      "region": "Equatorial Pacific warm-water-volume box (5°S–5°N, 120°E–80°W)",
      "role": "Subsurface heat storage"
    },
    {
      "name": "Indian Ocean Dipole (IOD)",
      "key": "iod_dmi",
      "source": "NOAA PSL Dipole Mode Index (DMI), HadISST1.1",
      "region": "Western minus eastern tropical Indian Ocean SST gradient",
      "role": "Indian Ocean variability"
    },
    {
      "name": "Equatorial Wind Anomalies",
      "key": "wind_anom",
      "source": "NCEP/NCAR Reanalysis surface zonal wind",
      "region": "Westerly Wind Burst region (5°S–5°N, 130°E–150°W)",
      "role": "Atmospheric forcing"
    },
    {
      "name": "Tropical Atlantic SST",
      "key": "atl_sst_anom",
      "source": "NOAA PSL Tropical Northern Atlantic (TNA) index",
      "region": "5.5°N–23.5°N, 15°W–57.5°W",
      "role": "Cross-basin interaction"
    }
  ],
